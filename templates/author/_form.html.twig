{{ form_start(form) }}
<div class="row g-3">
    <div class="col-md-6">{{ form_row(form.name) }}</div>
    <div class="col-md-6">{{ form_row(form.surname) }}</div>
    <div class="col-12">{{ form_row(form.workAddress) }}</div>
    <div class="col-md-4">{{ form_row(form.interest1) }}</div>
    <div class="col-md-4">{{ form_row(form.interest2) }}</div>
    <div class="col-md-4">{{ form_row(form.interest3) }}</div>
    <div class="col-md-6">{{ form_row(form.origin) }}</div>
</div>
<div class="mt-4">
    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i> Enregistrer</button>
    <a href="{{ path('app_author_index') }}" class="btn btn-outline-secondary ms-2"><i class="bi bi-arrow-left me-1"></i> Retour</a>
</div>
{{ form_end(form) }}
