{% extends 'base.html.twig' %}
{% block title %}{{ author.name }} {{ author.surname }}{% endblock %}
{% block body %}
<div class="page-header fade-up">
    <div>
        <div class="page-eyebrow">Auteurs</div>
        <h2>{{ author.name }} {{ author.surname }}</h2>
    </div>
    <div class="d-flex gap-2">
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_author_edit', {'id': author.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i> Modifier</a>
        {% endif %}
        <a href="{{ path('app_author_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>
</div>
<div class="row justify-content-center fade-up">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">Informations de l'auteur</div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <div class="form-label">Nom</div>
                        <div style="font-family:var(--font-display);font-size:17px;font-weight:700;color:var(--text);">{{ author.name }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-label">Prenom</div>
                        <div style="font-family:var(--font-display);font-size:17px;font-weight:700;color:var(--text);">{{ author.surname }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-label">Origine</div>
                        <div>{{ author.origin ?? '—' }}</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-label">Adresse de travail</div>
                        <div>{{ author.workAddress ?? '—' }}</div>
                    </div>
                    <div class="col-12">
                        <div class="form-label">Centres d'interet</div>
                        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:4px;">
                            {% if author.interest1 %}<span class="badge-keyword">{{ author.interest1 }}</span>{% endif %}
                            {% if author.interest2 %}<span class="badge-keyword">{{ author.interest2 }}</span>{% endif %}
                            {% if author.interest3 %}<span class="badge-keyword">{{ author.interest3 }}</span>{% endif %}
                            {% if not author.interest1 and not author.interest2 and not author.interest3 %}—{% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
