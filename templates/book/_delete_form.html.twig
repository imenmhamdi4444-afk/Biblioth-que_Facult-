<form method="post" action="{{ path('app_book_delete', {'id': book.id}) }}" onsubmit="return confirm('Supprimer ce livre ?')">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
    <button class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i>Supprimer</button>
</form>
