{% extends 'base.html.twig' %}
{% block title %}Modifier — {{ book.title }}{% endblock %}
{% block body %}
<div class="page-header fade-up">
    <div><div class="page-eyebrow">Livres / Modifier</div><h2>{{ book.title }}</h2></div>
    <a href="{{ path('app_book_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
</div>
<div class="row justify-content-center fade-up">
    <div class="col-md-10">
        <div class="card mb-3"><div class="card-body">{{ include('book/_form.html.twig') }}</div></div>
        <div class="card" style="border-color:#FCA5A5;">
            <div class="card-header" style="color:#9B2226;background:#FEF2F2;">Zone de danger</div>
            <div class="card-body">
                <p style="font-size:13px;color:var(--text-muted);margin-bottom:12px;">La suppression d'un livre est definitive.</p>
                {{ include('book/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
