{% extends 'base.html.twig' %}
{% block title %}{{ book.title }}{% endblock %}
{% block body %}
<div class="page-header fade-up">
  <div>
    <div class="page-eyebrow">Livres / {{ book.code }}</div>
    <h2>{{ book.title }}</h2>
  </div>
  <div class="d-flex gap-2">
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i> Modifier</a>
    {% endif %}
    <a href="{{ path('app_book_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
  </div>
</div>
<div class="row g-4 fade-up">
  <div class="col-md-3">
    {% if book.image %}
      <img src="{{ asset('uploads/covers/' ~ book.image) }}" alt="{{ book.title }}" style="width:100%;border-radius:3px;border:1px solid var(--border);box-shadow:0 4px 16px rgba(0,0,0,.08);">
    {% else %}
      <div style="width:100%;aspect-ratio:2/3;background:var(--gold-light);border-radius:3px;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:3rem;border:1px solid var(--border);"><i class="bi bi-book"></i></div>
    {% endif %}
    <div style="margin-top:20px;display:flex;flex-direction:column;gap:10px;">
      <div class="stat-card"><div class="stat-icon"><i class="bi bi-journals"></i></div><div><div class="stat-value">{{ book.nbCopiesAcquired }}</div><div class="stat-label">Acquis</div></div></div>
      <div class="stat-card"><div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div><div><div class="stat-value">{{ book.nbCopiesBorrowed }}</div><div class="stat-label">En pret</div></div></div>
    </div>
  </div>
  <div class="col-md-9">
    <div class="card">
      <div class="card-header">Informations generales</div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-sm-3"><div class="form-label">Code</div><code>{{ book.code }}</code></div>
          <div class="col-sm-9"><div class="form-label">Titre</div><div style="font-family:var(--font-display);font-size:18px;font-weight:600;color:var(--text);">{{ book.title }}</div></div>
          <div class="col-sm-4"><div class="form-label">Date de parution</div><div>{{ book.publicationDate ? book.publicationDate|date('d/m/Y') : '—' }}</div></div>
          <div class="col-sm-8"><div class="form-label">Maison d'edition</div><div>{{ book.publisher ? book.publisher.raisonSociale : '—' }}</div></div>
          <div class="col-12"><div class="form-label">Auteur(s)</div><div>{% for a in book.authors %}<span class="badge bg-secondary me-1">{{ a }}</span>{% else %}—{% endfor %}</div></div>
          <div class="col-12"><div class="form-label">Mots cles</div><div>{% if book.keywords %}{% for kw in book.keywords|split(',') %}<span class="badge-keyword">{{ kw|trim }}</span>{% endfor %}{% else %}—{% endif %}</div></div>
          <div class="col-sm-4"><div class="form-label">Disponibilite</div>
            {% set available = book.nbCopiesAcquired - book.nbCopiesBorrowed %}
            {% if available > 0 %}<span class="badge bg-success">{{ available }} disponible(s)</span>{% else %}<span class="badge bg-danger">Epuise</span>{% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
