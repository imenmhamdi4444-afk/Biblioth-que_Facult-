    <div class="card" style="border-color:#FCA5A5;"><div class="card-header" style="color:#9B2226;background:#FEF2F2;">Zone de danger</div><div class="card-body">{{ include('borrowing/_delete_form.html.twig') }}</div></div>
  </div>
