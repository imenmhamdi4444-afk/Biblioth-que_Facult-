{% extends 'base.html.twig' %}
{% block title %}Nouveau Pret{% endblock %}
{% block body %}
<div class="page-header fade-up">
    <div><div class="page-eyebrow">Prets</div><h2>Enregistrer un pret</h2></div>
    <a href="{{ path('app_borrowing_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
</div>
<div class="row justify-content-center fade-up">
    <div class="col-md-7">

        {# Show who the borrowing is for when a regular user is logged in #}
        {% if not is_granted('ROLE_ADMIN') and app.user.student %}
        <div style="background:var(--gold-light);border:1px solid rgba(184,150,12,.3);border-left:4px solid var(--gold);border-radius:3px;padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;gap:12px;">
            <i class="bi bi-person-fill" style="color:var(--gold);font-size:18px;"></i>
            <div>
                <div style="font-family:var(--font-mono);font-size:10px;color:var(--gold-hover);letter-spacing:.15em;text-transform:uppercase;margin-bottom:3px;">Emprunt pour</div>
                <div style="font-family:var(--font-display);font-size:15px;font-weight:700;color:var(--text);">
                    {{ app.user.student.name }} {{ app.user.student.surname|upper }}
                    {% if app.user.student.matricule %}
                        <span style="font-family:var(--font-mono);font-size:12px;color:var(--text-muted);font-weight:400;margin-left:8px;">{{ app.user.student.matricule }}</span>
                    {% endif %}
                </div>
            </div>
        </div>
        {% elseif not is_granted('ROLE_ADMIN') and not app.user.student %}
        <div style="background:#FEF2F2;border:1px solid #FCA5A5;border-left:4px solid #EF4444;border-radius:3px;padding:14px 18px;margin-bottom:20px;">
            <div style="font-family:var(--font-ui);font-size:13px;color:#9B2226;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Votre compte n'est pas lié à un profil étudiant. Contactez l'administrateur.
            </div>
        </div>
        {% endif %}

        <div class="card">
            <div class="card-header">
                {% if is_granted('ROLE_ADMIN') %}
                    <i class="bi bi-person-fill me-2" style="color:var(--gold)"></i>Sélectionner un étudiant et un document
                {% else %}
                    <i class="bi bi-journal-bookmark-fill me-2" style="color:var(--gold)"></i>Choisir un document
                {% endif %}
            </div>
            <div class="card-body">
                {{ include('borrowing/_form.html.twig', { form: form, button_label: 'Enregistrer le prêt' }) }}
            </div>
        </div>

    </div>
</div>
{% endblock %}
