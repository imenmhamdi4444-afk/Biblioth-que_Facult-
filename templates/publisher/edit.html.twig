{% extends 'base.html.twig' %}
{% block title %}Modifier — {{ publisher.raisonSociale }}{% endblock %}
{% block body %}
<div class="page-header fade-up">
    <div><div class="page-eyebrow">Maisons d'edition / Modifier</div><h2>{{ publisher.raisonSociale }}</h2></div>
    <a href="{{ path('app_publisher_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
</div>
<div class="row justify-content-center fade-up">
    <div class="col-md-8">
        <div class="card mb-3"><div class="card-body">{{ include('publisher/_form.html.twig') }}</div></div>
        <div class="card" style="border-color:#FCA5A5;">
            <div class="card-header" style="color:#9B2226;background:#FEF2F2;">Zone de danger</div>
            <div class="card-body">
                <p style="font-size:13px;color:var(--text-muted);margin-bottom:12px;">Impossible de supprimer si des livres ou revues sont lies.</p>
                {{ include('publisher/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
