{% extends 'base.html.twig' %}
{% block title %}Maisons d edition{% endblock %}
{% block body %}
<div class="page-header fade-up">
  <div><div class="page-eyebrow">References</div><h2>Maisons d edition</h2></div>
  {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_publisher_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle maison</a>{% endif %}
</div>
<div class="table-wrapper fade-up">
  <table class="table">
    <thead><tr><th>Raison sociale</th><th>Adresse</th><th>Directeur</th><th>Resp. commercial</th><th>Livres</th><th>Revues</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    {% for publisher in publishers %}
    <tr>
      <td><div style="font-family:var(--font-display);font-weight:600;color:var(--text);">{{ publisher.raisonSociale }}</div></td>
      <td style="font-size:13px;color:var(--text-muted);">{{ publisher.address }}</td>
      <td style="font-size:13px;">{{ publisher.directorName }}</td>
      <td style="font-size:13px;">{{ publisher.commercialContact }}</td>
      <td><span class="badge bg-primary">{{ publisher.books|length }}</span></td>
      <td><span class="badge bg-secondary">{{ publisher.revues|length }}</span></td>
      <td class="text-end">
        <a href="{{ path('app_publisher_show', {'id': publisher.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_publisher_edit', {'id': publisher.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i></a>
        {{ include('publisher/_delete_form.html.twig') }}
        {% endif %}
      </td>
    </tr>
    {% else %}
    <tr><td colspan="7"><div class="empty-state"><i class="bi bi-building-x"></i><p>Aucune maison d edition.</p></div></td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
