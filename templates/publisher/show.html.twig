{% extends 'base.html.twig' %}
{% block title %}{{ publisher.raisonSociale }}{% endblock %}
{% block body %}
<div class="page-header fade-up">
    <div>
        <div class="page-eyebrow">Maisons d'edition</div>
        <h2>{{ publisher.raisonSociale }}</h2>
    </div>
    <div class="d-flex gap-2">
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_publisher_edit', {'id': publisher.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i> Modifier</a>
        {% endif %}
        <a href="{{ path('app_publisher_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>
</div>
<div class="row g-4 fade-up">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Informations</div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12"><div class="form-label">Raison sociale</div><div style="font-family:var(--font-display);font-size:18px;font-weight:700;color:var(--text);">{{ publisher.raisonSociale }}</div></div>
                    <div class="col-12"><div class="form-label">Adresse</div><div>{{ publisher.address }}</div></div>
                    <div class="col-sm-6"><div class="form-label">Directeur</div><div style="font-weight:600;color:var(--text);">{{ publisher.directorName }}</div></div>
                    <div class="col-sm-6"><div class="form-label">Responsable commercial</div><div style="font-weight:600;color:var(--text);">{{ publisher.commercialContact }}</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card mb-3" style="flex-direction:column;align-items:flex-start;gap:8px;">
            <div style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:.15em;text-transform:uppercase;">Livres publies</div>
            <div style="font-family:var(--font-display);font-size:2.5rem;font-weight:700;color:var(--text);line-height:1;">{{ publisher.books|length }}</div>
        </div>
        <div class="stat-card" style="flex-direction:column;align-items:flex-start;gap:8px;">
            <div style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:.15em;text-transform:uppercase;">Revues publiees</div>
            <div style="font-family:var(--font-display);font-size:2.5rem;font-weight:700;color:var(--gold);line-height:1;">{{ publisher.revues|length }}</div>
        </div>
    </div>
</div>
{% endblock %}
