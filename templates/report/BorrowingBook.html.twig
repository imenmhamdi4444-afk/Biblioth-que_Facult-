{% extends 'base.html.twig' %}
{% block title %}Historique par document{% endblock %}
{% block body %}
<div class="page-header fade-up">
  <div><div class="page-eyebrow">Administration</div><h2>Historique par document</h2></div>
</div>
<div class="card mb-4 fade-up">
  <div class="card-header"><i class="bi bi-funnel me-2" style="color:var(--gold)"></i>Filtrer par document</div>
  <div class="card-body">
    {{ form_start(form, {'attr': {'class': 'row g-3 align-items-end'}}) }}
      <div class="col-md-8">{{ form_label(form.book) }}{{ form_widget(form.book, {'attr': {'class': 'form-select'}}) }}</div>
      <div class="col-md-4"><button class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Filtrer</button></div>
    {{ form_end(form) }}
  </div>
</div>
<div class="table-wrapper fade-up">
  <table class="table">
    <thead><tr><th>Etudiant</th><th>Date du pret</th><th class="text-center">Retourne</th></tr></thead>
    <tbody>
    {% for borrowing in borrowings %}
    <tr>
      <td>
        <div style="font-family:var(--font-display);font-weight:600;color:var(--text);">{{ borrowing.student.name }} {{ borrowing.student.surname|upper }}</div>
        {% if borrowing.student.matricule %}<div style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);">{{ borrowing.student.matricule }}</div>{% endif %}
      </td>
      <td style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted);">{{ borrowing.dateBorrowed|date('d/m/Y') }}</td>
      <td class="text-center">{% if borrowing.bookReturned %}<span class="badge bg-success">Oui</span>{% else %}<span class="badge bg-warning">Non</span>{% endif %}</td>
    </tr>
    {% else %}
    <tr><td colspan="3"><div class="empty-state"><i class="bi bi-inbox"></i><p>Aucun pret trouve pour ce document.</p></div></td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>
<div class="mt-3"><a href="{{ path('app_borrowing_index') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Retour aux prets</a></div>
{% endblock %}
