<form method="post" action="{{ path('app_revue_delete', {'id': revue.id}) }}"
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette revue ? Cette action est irréversible.')">
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ revue.id) }}">
    <button class="btn btn-danger btn-sm">
        <i class="bi bi-trash me-1"></i>Supprimer
    </button>
</form>
