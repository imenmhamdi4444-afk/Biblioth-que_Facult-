{{ form_start(form) }}
<div class="row g-3">
    <div class="col-md-4">{{ form_row(form.code) }}</div>
    <div class="col-md-8">{{ form_row(form.title) }}</div>
    <div class="col-md-4">{{ form_row(form.publicationDate) }}</div>
    <div class="col-md-4">{{ form_row(form.nbCopiesAcquired) }}</div>
    <div class="col-md-4">{{ form_row(form.nbCopiesBorrowed) }}</div>
    <div class="col-md-6">{{ form_row(form.publisher) }}</div>
    <div class="col-md-6">{{ form_row(form.keywords) }}</div>
    <div class="col-12">
        <label class="form-label">Auteur(s) <small class="text-muted">(Ctrl+clic pour sélection multiple)</small></label>
        {{ form_widget(form.authors) }}
        {{ form_errors(form.authors) }}
    </div>
    <div class="col-12"><hr style="border-color:var(--lib-border)"><p class="form-label mb-2" style="font-size:.9rem;font-weight:600;color:var(--lib-text)">Abonnement</p></div>
    <div class="col-md-4">{{ form_row(form.periodicity) }}</div>
    <div class="col-md-4">{{ form_row(form.subscriptionDate) }}</div>
    <div class="col-md-4">{{ form_row(form.subscriptionAmount) }}</div>
</div>
<div class="mt-4">
    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i> Enregistrer</button>
    <a href="{{ path('app_revue_index') }}" class="btn btn-outline-secondary ms-2"><i class="bi bi-arrow-left me-1"></i> Retour</a>
</div>
{{ form_end(form) }}
