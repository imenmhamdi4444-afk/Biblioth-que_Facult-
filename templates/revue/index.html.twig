{% extends 'base.html.twig' %}
{% block title %}Revues{% endblock %}
{% block body %}
<div class="page-header fade-up">
  <div><div class="page-eyebrow">Catalogue</div><h2>Revues</h2></div>
  {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_revue_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle revue</a>{% endif %}
</div>
<form method="GET" action="{{ path('app_revue_index') }}" class="mb-4 fade-up">
  <div class="d-flex gap-2 align-items-center">
    <div class="search-bar" style="max-width:440px;flex:1;"><i class="bi bi-search"></i><input type="text" name="keyword" class="form-control" placeholder="Titre, code, mots cles..." value="{{ keyword }}"></div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Rechercher</button>
    {% if keyword %}<a href="{{ path('app_revue_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>{% endif %}
  </div>
  {% if keyword %}<p style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted);margin-top:10px;">{{ revues|length }} resultat(s) pour « {{ keyword }} »</p>{% endif %}
</form>
<div class="table-wrapper fade-up">
  <table class="table">
    <thead><tr><th>Couverture</th><th>Code</th><th>Titre</th><th>Periodicite</th><th>Editeur</th><th>Abonnement</th><th>Stock</th><th>Disponibilite</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
    {% for revue in revues %}
    <tr>
      <td>
        {% if revue.image %}<img src="{{ asset('uploads/covers/' ~ revue.image) }}" alt="{{ revue.title }}" style="width:38px;height:52px;object-fit:cover;border-radius:2px;border:1px solid var(--border);">
        {% else %}<div style="width:38px;height:52px;background:var(--gold-light);border-radius:2px;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:14px;"><i class="bi bi-newspaper"></i></div>{% endif %}
      </td>
      <td><code>{{ revue.code }}</code></td>
      <td><div style="font-family:var(--font-display);font-weight:600;color:var(--text);font-size:14px;">{{ revue.title }}</div></td>
      <td>{% if revue.periodicity %}<span class="badge bg-info">{{ revue.periodicity }}</span>{% else %}—{% endif %}</td>
      <td style="font-size:12px;color:var(--text-muted);">{{ revue.publisher ? revue.publisher.raisonSociale : '—' }}</td>
      <td style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted);">{% if revue.subscriptionDate %}{{ revue.subscriptionDate|date('d/m/Y') }}{% if revue.subscriptionAmount %}<br>{{ revue.subscriptionAmount }} DZD{% endif %}{% else %}—{% endif %}</td>
      <td style="font-size:12px;"><span class="badge bg-primary">{{ revue.nbCopiesAcquired }}</span> / <span class="badge {% if revue.nbCopiesBorrowed > 0 %}bg-warning{% else %}bg-success{% endif %}">{{ revue.nbCopiesBorrowed }}</span></td>
      <td>{% set available = revue.nbCopiesAcquired - revue.nbCopiesBorrowed %}{% if available > 0 %}<span class="badge bg-success">{{ available }} dispo</span>{% else %}<span class="badge bg-danger">Epuise</span>{% endif %}</td>
      <td class="text-end">
        <a href="{{ path('app_revue_show', {'id': revue.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_revue_edit', {'id': revue.id}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i></a>
        {{ include('revue/_delete_form.html.twig') }}
        {% endif %}
      </td>
    </tr>
    {% else %}
    <tr><td colspan="9"><div class="empty-state"><i class="bi bi-newspaper"></i><p>Aucune revue trouvee.</p></div></td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
