{% extends 'base.html.twig' %}
{% block title %}{{ revue.title }}{% endblock %}
{% block body %}
<div class="page-header fade-up">
    <div>
        <div class="page-eyebrow">Revues / {{ revue.code }}</div>
        <h2>{{ revue.title }}</h2>
    </div>
    <div class="d-flex gap-2">
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_revue_edit', {'id': revue.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i> Modifier</a>
        {% endif %}
        <a href="{{ path('app_revue_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>
</div>
<div class="row g-4 fade-up">
    <div class="col-md-3">
        {% if revue.image %}
            <img src="{{ asset('uploads/covers/' ~ revue.image) }}" alt="{{ revue.title }}" style="width:100%;border-radius:3px;border:1px solid var(--border);box-shadow:0 4px 16px rgba(0,0,0,.08);">
        {% else %}
            <div style="width:100%;aspect-ratio:2/3;background:var(--gold-light);border-radius:3px;display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:3rem;border:1px solid var(--border);"><i class="bi bi-newspaper"></i></div>
        {% endif %}
        <div style="margin-top:20px;display:flex;flex-direction:column;gap:10px;">
            <div class="stat-card"><div class="stat-icon"><i class="bi bi-journals"></i></div><div><div class="stat-value">{{ revue.nbCopiesAcquired }}</div><div class="stat-label">Acquis</div></div></div>
            <div class="stat-card"><div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div><div><div class="stat-value">{{ revue.nbCopiesBorrowed }}</div><div class="stat-label">En pret</div></div></div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card mb-3">
            <div class="card-header">Informations generales</div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-sm-3"><div class="form-label">Code</div><code>{{ revue.code }}</code></div>
                    <div class="col-sm-9"><div class="form-label">Titre</div><div style="font-family:var(--font-display);font-size:18px;font-weight:600;color:var(--text);">{{ revue.title }}</div></div>
                    <div class="col-sm-4"><div class="form-label">Date de parution</div><div>{{ revue.publicationDate ? revue.publicationDate|date('d/m/Y') : '—' }}</div></div>
                    <div class="col-sm-8"><div class="form-label">Maison d'edition</div><div>{{ revue.publisher ? revue.publisher.raisonSociale : '—' }}</div></div>
                    <div class="col-12"><div class="form-label">Auteur(s)</div><div>{% for a in revue.authors %}<span class="badge bg-secondary me-1">{{ a }}</span>{% else %}—{% endfor %}</div></div>
                    <div class="col-12"><div class="form-label">Mots cles</div><div>{% if revue.keywords %}{% for kw in revue.keywords|split(',') %}<span class="badge-keyword">{{ kw|trim }}</span>{% endfor %}{% else %}—{% endif %}</div></div>
                    <div class="col-sm-4"><div class="form-label">Disponibilite</div>
                        {% set available = revue.nbCopiesAcquired - revue.nbCopiesBorrowed %}
                        {% if available > 0 %}<span class="badge bg-success">{{ available }} disponible(s)</span>{% else %}<span class="badge bg-danger">Epuise</span>{% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header">Abonnement</div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-sm-4"><div class="form-label">Periodicite</div><div>{% if revue.periodicity %}<span class="badge bg-info">{{ revue.periodicity }}</span>{% else %}—{% endif %}</div></div>
                    <div class="col-sm-4"><div class="form-label">Date d'abonnement</div><div style="font-family:var(--font-mono);font-size:13px;">{{ revue.subscriptionDate ? revue.subscriptionDate|date('d/m/Y') : '—' }}</div></div>
                    <div class="col-sm-4"><div class="form-label">Montant</div><div style="font-family:var(--font-display);font-size:16px;font-weight:600;color:var(--text);">{{ revue.subscriptionAmount ? revue.subscriptionAmount ~ ' DZD' : '—' }}</div></div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
