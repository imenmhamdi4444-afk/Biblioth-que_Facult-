<form method="post" action="{{ path('app_student_delete', {'id': student.id}) }}"
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet étudiant ? Cette action est irréversible.')">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ student.id) }}">
    <button class="btn btn-danger btn-sm">
        <i class="bi bi-trash me-1"></i>Supprimer cet étudiant
    </button>
</form>
