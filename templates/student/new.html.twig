{% extends 'base.html.twig' %}

{% block title %}Nouvel Étudiant — BiblioFac{% endblock %}
{% block page_title %}Ajouter un étudiant{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-4">Informations personnelles</h2>
                
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <button class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Enregistrer
                        </button>
                        <a href="{{ path('app_student_index') }}" class="btn btn-outline-secondary ms-2">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}