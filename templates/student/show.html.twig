{% extends 'base.html.twig' %}
{% block title %}{{ student.name }} {{ student.surname }}{% endblock %}
{% block body %}
<div class="page-header fade-up">
  <div><div class="page-eyebrow">Etudiants</div><h2>{{ student.name }} {{ student.surname|upper }}</h2></div>
  <div class="d-flex gap-2">
    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_student_edit', {'id': student.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i> Modifier</a>{% endif %}
    <a href="{{ path('app_student_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
  </div>
</div>
<div class="row justify-content-center fade-up">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">Informations de l'etudiant</div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-sm-6"><div class="form-label">Matricule</div><code>{{ student.matricule ?? '—' }}</code></div>
          <div class="col-sm-6"><div class="form-label">Filiere</div><div>{{ student.department ?? '—' }}</div></div>
          <div class="col-sm-6"><div class="form-label">Prenom</div><div style="font-family:var(--font-display);font-size:16px;font-weight:600;color:var(--text);">{{ student.name }}</div></div>
          <div class="col-sm-6"><div class="form-label">Nom</div><div style="font-family:var(--font-display);font-size:16px;font-weight:600;color:var(--text);">{{ student.surname|upper }}</div></div>
          <div class="col-12"><div class="form-label">Email</div><div style="font-family:var(--font-mono);font-size:13px;">{{ student.email ?? '—' }}</div></div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
